# netplan v2, rendered by NetworkManager on Raspberry Pi OS Trixie.
# optional: false on wlan0 makes the first boot wait for Wi-Fi so the apt installs have network.
# Preference between the two networks is set after install by firstboot.sh (nmcli autoconnect-priority).
network:
  version: 2
  ethernets:
    eth0:
      dhcp4: true
      dhcp6: true
      optional: true
  wifis:
    wlan0:
      dhcp4: true
      dhcp6: true
      optional: false
      regulatory-domain: {{WIFI_COUNTRY}}
      access-points:
{{ACCESS_POINTS}}
