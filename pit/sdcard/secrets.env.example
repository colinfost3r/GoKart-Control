# Copy to secrets.env (gitignored) and fill in. Values are plain strings;
# quote them if they contain spaces or shell symbols.

# Primary Wi-Fi (preferred when both are in range)
WIFI_SSID=mclab
WIFI_PASSWORD=
WIFI_COUNTRY=US

# Optional second Wi-Fi (leave both empty to skip)
WIFI2_SSID=
WIFI2_PASSWORD=

# Linux account on the Pi (also the ssh login)
PI_USER=pit
PI_PASSWORD=

# Shared password for the pit web UI from other computers (the on-Pi kiosk skips it)
PIT_WEB_PASSWORD=

# Optional: Tailscale auth key (https://login.tailscale.com/admin/settings/keys).
# Empty = Tailscale is not installed.
TAILSCALE_AUTHKEY=

# Not secret, just config
PI_HOSTNAME=gokart-pit
TIMEZONE=America/New_York
