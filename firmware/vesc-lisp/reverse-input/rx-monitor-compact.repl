(let ((a (systime)) (b (systime)) (r (gpio-read 'pin-rx)) (e 0) (n 0)) (progn (loopwhile (< (secs-since a) 30) (let ((v (gpio-read 'pin-rx))) (progn (if (!= v r) (progn (setvar 'r v) (setvar 'e (+ e 1)))) (setvar 'n (+ n 1)) (if (>= (secs-since b) 1) (progn (print (list (secs-since a) r e n (get-adc-decoded 0) (get-rpm) (get-fault))) (setvar 'b (systime)))) (sleep 0.002)))) (print (list 'done e n))))
