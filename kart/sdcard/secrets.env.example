# Copy to secrets.env (gitignored) and fill in. Values are plain strings;
# quote them if they contain spaces or shell symbols.

# Which kart this card is for (1-8): hostname gokart-kart-N, display label.
# The Heltec's own id still wins on screen; a mismatch is flagged.
KART_ID=2

# Primary Wi-Fi (preferred when both are in range). The Pi 3 B is 2.4 GHz only.
WIFI_SSID=McLab
WIFI_PASSWORD=
WIFI_COUNTRY=US

# Optional second Wi-Fi (leave both empty to skip)
WIFI2_SSID=
WIFI2_PASSWORD=

# Linux account on the Pi (also the ssh login)
PI_USER=kart
PI_PASSWORD=

# Public key authorized for ssh (kart/deploy.sh). "none" to skip.
SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub

# Optional: Tailscale auth key. Empty = Tailscale is not installed.
TAILSCALE_AUTHKEY=

# Not secret, just config
# PI_HOSTNAME=gokart-kart-2          # default gokart-kart-$KART_ID
# PIT_URLS=http://gokart-pit.local:8080,http://192.168.151.240:8080
TIMEZONE=America/New_York
